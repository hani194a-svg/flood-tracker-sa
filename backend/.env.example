# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/floods
# Set to true for Supabase / any hosted Postgres
DATABASE_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

PORT=4000
CORS_ORIGINS=http://localhost:5173

# Anti-spam
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MS=600000
DUPLICATE_RADIUS_M=200
DUPLICATE_WINDOW_MIN=10
